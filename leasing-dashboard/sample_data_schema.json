{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sample_data_schema.json",
  "title": "週次リーシングダッシュボード 入力データスキーマ",
  "description": "dashboard_spec.md の入力契約を JSON Schema で表したもの。null は「データなし」、0 は「確認済みの 0」。未知の列は無視される（後方互換）ため additionalProperties は許可する。",
  "type": "object",
  "required": [
    "report_metadata",
    "properties"
  ],
  "additionalProperties": true,
  "properties": {
    "report_metadata": {
      "type": "object",
      "required": [
        "source_period"
      ],
      "additionalProperties": true,
      "properties": {
        "report_date": {
          "type": [
            "string",
            "null"
          ],
          "description": "レポート日"
        },
        "source_period": {
          "type": [
            "string",
            "number"
          ],
          "description": "対象週（例: YYYYMMDD）。画面上の対象週として表示する"
        },
        "file_count_expected": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "想定ファイル数"
        },
        "file_count_processed": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "処理できたファイル数"
        },
        "file_count_failed": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "失敗ファイル数"
        },
        "generated_by": {
          "type": [
            "string",
            "null"
          ],
          "description": "生成元"
        },
        "contains_personal_data": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "個人情報を含むか"
        },
        "is_provisional": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "（任意）true なら全体を暫定表示"
        },
        "is_sample": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "（任意）true なら架空サンプルとして表示"
        }
      }
    },
    "portfolio_summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": [
            "string",
            "null"
          ],
          "description": "例: calculated / not_calculated"
        },
        "is_provisional": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "description": "未算出等の理由コード"
        },
        "property_count": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "total_units": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "occupied_units": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "vacant_units": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "application_units": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "scheduled_contract_units": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "scheduled_termination_units": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "occupancy_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "occupancy_after_application": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "数値があれば物件明細からの再計算値と突合する"
    },
    "properties": {
      "type": "array",
      "description": "Project # × report_date ごとに 1 レコード",
      "items": {
        "type": "object",
        "required": [
          "project_number"
        ],
        "additionalProperties": true,
        "properties": {
          "report_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "レポート日（YYYY-MM-DD 等）。基準週の判定に使う"
          },
          "project_number": {
            "type": [
              "string",
              "null"
            ],
            "description": "Project #（内部結合キー。property_master.csv と結合）"
          },
          "project_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "参考値。表示は property_master.csv を正とする"
          },
          "property_name_ja": {
            "type": [
              "string",
              "null"
            ],
            "description": "参考値。表示は property_master.csv を正とする"
          },
          "property_name_en": {
            "type": [
              "string",
              "null"
            ],
            "description": "参考値。表示は property_master.csv を正とする"
          },
          "spc": {
            "type": [
              "string",
              "null"
            ],
            "description": "参考値（マスター優先）"
          },
          "am": {
            "type": [
              "string",
              "null"
            ],
            "description": "参考値（マスター優先）。会社名等。個人名は入れない"
          },
          "pm": {
            "type": [
              "string",
              "null"
            ],
            "description": "参考値（マスター優先）。会社名等。個人名は入れない"
          },
          "occupancy_calculation_formula": {
            "type": [
              "string",
              "null"
            ],
            "description": "稼働率の計算式（文字列）"
          },
          "major_change_from_previous_week": {
            "type": [
              "string",
              "null"
            ],
            "description": "前週からの主要変化"
          },
          "leasing_issue": {
            "type": [
              "string",
              "null"
            ],
            "description": "リーシング課題"
          },
          "pm_comment": {
            "type": [
              "string",
              "null"
            ],
            "description": "PMコメント（個人名・連絡先を含めない）"
          },
          "am_review_item": {
            "type": [
              "string",
              "null"
            ],
            "description": "AM確認事項"
          },
          "source_file_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "元ファイル名（パスは含めない）"
          },
          "source_sheet_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "元シート名"
          },
          "data_confidence": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "high",
              "medium",
              "low",
              null
            ],
            "description": "データ確度"
          },
          "error_detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "読取エラー等の詳細"
          },
          "total_units": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "総戸数"
          },
          "occupied_units": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "稼働戸数"
          },
          "vacant_units": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "空室戸数"
          },
          "application_units": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "申込戸数"
          },
          "scheduled_contract_units": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "契約予定戸数"
          },
          "scheduled_termination_units": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "解約予定戸数"
          },
          "occupancy_rate_source": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "元データ記載の稼働率（0〜1 の小数）"
          },
          "occupancy_rate_calculated": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "元データ側の計算稼働率（0〜1）"
          },
          "occupancy_calculation_numerator": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "稼働率の分子"
          },
          "occupancy_calculation_denominator": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "稼働率の分母"
          },
          "occupancy_after_application_source": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "元データ記載の申込反映後稼働率（0〜1）"
          },
          "occupancy_after_application_calculated": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "申込反映後稼働率（0〜1）。元データ定義上算出が許される場合のみ値を入れ、それ以外は null"
          },
          "leasing_units": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "募集中戸数"
          },
          "new_leasing_units": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "新規募集戸数"
          },
          "long_vacancy_units": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "長期空室戸数"
          },
          "average_vacancy_days": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "平均空室日数"
          },
          "maximum_vacancy_days": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "最大空室日数"
          },
          "current_rent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "現行賃料（円）"
          },
          "asking_rent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "募集賃料（円）"
          },
          "rent_revision_amount": {
            "type": [
              "number",
              "null"
            ],
            "description": "賃料改定額（円。負の値可）"
          },
          "ad": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "AD（元データ単位）"
          },
          "fr": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "FR（元データ単位）"
          },
          "viewing_count": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "内見数"
          },
          "inquiry_count": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "反響数"
          },
          "application_count": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "申込件数"
          },
          "contract_count": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "契約件数"
          },
          "application_cancel_count": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "（任意・仕様外の拡張）申込取消件数。あれば「申込取消」アラートに使う"
          }
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "severity": {
            "enum": [
              "error",
              "warning",
              "info"
            ]
          },
          "code": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_number": {
            "type": [
              "string",
              "number",
              "null"
            ]
          }
        }
      }
    },
    "validation_summary": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "success": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "partial": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "failed": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "property_linked": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "duplicate_candidates": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "low_confidence_records": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "file_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "file_name"
        ],
        "additionalProperties": true,
        "properties": {
          "file_name": {
            "type": "string",
            "description": "ファイル名（パス・URL は含めない）"
          },
          "status": {
            "enum": [
              "success",
              "partial",
              "failed"
            ]
          }
        }
      }
    },
    "units": {
      "type": "array",
      "description": "（任意・dashboard_spec.md の拡張）住戸明細。Project # × 住戸番号 × report_date ごとに 1 レコード。空室・申込・契約済・解約予定・工事中の住戸を載せる（入居中で動きのない住戸は省略可）。ない場合は住戸単位の画面が「住戸明細なし」になる。",
      "items": {
        "type": "object",
        "required": [
          "project_number",
          "unit_number"
        ],
        "additionalProperties": true,
        "properties": {
          "report_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "レポート日。省略時は source_period"
          },
          "project_number": {
            "type": [
              "string",
              "number"
            ],
            "description": "Project #（物件マスターと結合）"
          },
          "unit_number": {
            "type": [
              "string",
              "number"
            ],
            "description": "住戸番号（部屋番号）"
          },
          "layout": {
            "type": [
              "string",
              "null"
            ],
            "description": "間取り（例: 1K）"
          },
          "floor_area_sqm": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "専有面積（㎡）"
          },
          "leasing_status": {
            "type": [
              "string",
              "null"
            ],
            "description": "募集状況",
            "enum": [
              "vacant",
              "application",
              "contracted",
              "occupied",
              "notice",
              "空室",
              "申込あり",
              "契約済",
              "入居中",
              "解約予定",
              null
            ]
          },
          "vacancy_start_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "空室になった日（退去日）。空室日数はこの日から基準日までで計算（YYYY-MM-DD）"
          },
          "vacancy_days": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "元データ記載の空室日数（空室開始日がない場合に使用）"
          },
          "application_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "申込日（YYYY-MM-DD）"
          },
          "application_cancel_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "申込取消日（YYYY-MM-DD）"
          },
          "notice_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "解約通知を受けた日（YYYY-MM-DD）"
          },
          "move_out_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "退去（予定）日（YYYY-MM-DD）"
          },
          "current_rent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "現行賃料（円）"
          },
          "asking_rent": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "募集賃料（円）"
          },
          "common_fee": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "共益費・管理費（円）"
          },
          "ad": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "AD（元データ単位）"
          },
          "fr": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "FR（元データ単位）"
          },
          "deposit_months": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "敷金（ヶ月）"
          },
          "key_money_months": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "礼金（ヶ月）"
          },
          "work_type": {
            "type": [
              "string",
              "null"
            ],
            "description": "工事種別",
            "enum": [
              "renovation",
              "restoration",
              "リノベ",
              "リノベーション",
              "原状回復",
              "原復",
              null
            ]
          },
          "work_start_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "工事開始日（YYYY-MM-DD）"
          },
          "work_end_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "工事完了予定日（YYYY-MM-DD）"
          },
          "work_completed_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "工事完了日（完了済みの場合）（YYYY-MM-DD）"
          },
          "unit_note": {
            "type": [
              "string",
              "null"
            ],
            "description": "住戸の補足（個人名・連絡先を含めない）"
          },
          "data_confidence": {
            "type": [
              "string",
              "null"
            ],
            "description": "データ確度",
            "enum": [
              "high",
              "medium",
              "low",
              null
            ]
          },
          "source_file_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "元ファイル名（パスは含めない）"
          },
          "counts_as_vacant": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "（任意）元の週報の稼働率の定義でこの住戸を空室に数えるか。ある場合は物件の空室戸数との突合に使う"
          }
        }
      }
    },
    "unit_events": {
      "type": "array",
      "description": "（任意）週報の解析で判明した住戸の動き。期間別シートの前週との差分（basis: diff）や条件変更の記載（basis: source）。今週の動きとして表示する",
      "items": {
        "type": "object",
        "required": [
          "type",
          "project_number",
          "unit_number"
        ],
        "additionalProperties": true,
        "properties": {
          "report_date": {
            "type": [
              "string",
              "null"
            ],
            "description": "対象週（週末の日付）"
          },
          "project_number": {
            "type": [
              "string",
              "number"
            ]
          },
          "unit_number": {
            "type": [
              "string",
              "number"
            ]
          },
          "type": {
            "enum": [
              "application",
              "application_cancel",
              "notice",
              "condition_change"
            ]
          },
          "date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "move_out_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "basis": {
            "enum": [
              "diff",
              "source"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_file_name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "action_items": {
      "type": "array",
      "description": "（任意）Action Points 型の対応事項。リーシングの数値には合算しない。メモ欄は含めない",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "project_number": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "property_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_date": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "priority": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
